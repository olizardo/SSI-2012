# .gitignore for SSI-2012 Website & Data Repository

# Quarto temporary directories
.quarto/
_site/

# R Project / Session files
.Rhistory
.RData
.RDataTmp
.RUserData
.Rproj.user/

# Python Cache & Virtual Environments
__pycache__/
*.pyc
.venv/
venv/
env/
.ipynb_checkpoints/

# IDE files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Word draft extractions (temporary local text files)
APPENDIX_text.txt
APPENDIX_text_docx.txt
Skiles_dissertation_text.txt
